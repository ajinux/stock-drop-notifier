# Environment files with secrets
.env

# Personal alert configuration (see alerts.yaml.example for a template)
/alerts.yaml

# Binary output (leading slash: must not match the cmd/notifier/ package dir)
/notifier
/stock-market-notifier
/bin/

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db
.opencode
graphify-out
