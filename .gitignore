# Environment files with secrets
.env

# Note: alerts.yaml IS tracked. The scheduled GitHub Actions workflow reads it
# from the repo, so your watchlist has to be committed for hosted checks to run.

# Binary output (leading slash: must not match the cmd/notifier/ package dir)
/notifier
/stock-drop-notifier
/bin/

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db
.opencode
graphify-out
